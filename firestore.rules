rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Daily tech news articles - public read, backend write only
    match /daily_articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // Clustered news events - public read, backend write only
    match /news_events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Ingestion health & sync status - public read, backend write only
    match /source_status/{sourceId} {
      allow read: if true;
      allow write: if false;
    }

    // Users and profiles - public read and write for demo mode
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /profiles/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Allow all other documents for demo mode
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
