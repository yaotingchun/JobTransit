{
  "name": "jobtransit-functions",
  "version": "1.0.0",
  "description": "Daily tech news ingestion, deduplication, enrichment, and ranking pipeline for JobTransit",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:collect": "tsx src/scripts/testCollect.ts",
    "ingest:local": "tsx src/scripts/runIngestion.ts",
    "weekly:compile": "tsx src/scripts/runWeeklyCompile.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "private": true
}
